{
  "name": "bilidownloader",
  "version": "0.0.0",
  "description": "B站视频下载工具 - 桌面应用版",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "typecheck": "vue-tsc -p frontend/tsconfig.json",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "build:electron": "electron-builder",
    "build:win": "npm run build:frontend && electron-builder --win portable --x64 --arm64",
    "build:mac": "npm run build:frontend && electron-builder --mac dmg --x64 --arm64",
    "build:linux": "npm run build:frontend && electron-builder --linux AppImage --x64 --arm64",
    "build:release": "npm run build:frontend && electron-builder --mac dmg --x64 --arm64 && electron-builder --win portable --x64 --arm64 && electron-builder --linux AppImage --x64 --arm64",
    "package": "npm run build:frontend && electron-builder --dir",
    "preview": "vite preview --config frontend/vite.config.ts",
    "lint": "eslint frontend/src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write frontend/src/",
    "postinstall": "electron-builder install-app-deps",
    "start": "electron ."
  },
  "keywords": [
    "bilibili",
    "download",
    "video",
    "electron",
    "desktop"
  ],
  "author": "BiliDownloader Team",
  "license": "MIT",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "element-plus": "^2.4.1",
    "ffmpeg-static": "^5.2.0",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.3.8",
    "vue-i18n": "^9.4.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/tsconfig": "^0.4.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "prettier": "^3.1.0",
    "sass": "^1.69.5",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^0.16.7",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.12",
    "wait-on": "^7.0.1"
  },
  "build": {
    "extends": "./electron-builder.config.js"
  }
}
